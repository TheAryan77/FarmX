# ---------- Database (Neon / Supabase / any hosted Postgres) ----------
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ---------- API (services/api, port 4000) ----------
API_PORT=4000
JWT_SECRET="change-me-in-local-dev-min-16-chars"
JWT_EXPIRES_IN="7d"
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002"

# ---------- AI service (services/ai, port 8000) ----------
AI_PORT=8000
AI_SERVICE_URL="http://localhost:8000"

# ---------- Web apps ----------
# Server-side only: the Next apps call the API from the server and attach
# the bearer token themselves, so this is never exposed to the browser.
API_URL="http://localhost:4000"

# ---------- Chain ----------
# Development runs against a local Hardhat node (`pnpm chain`). Switching to
# Polygon Amoy is a matter of pointing these at Amoy and redeploying — the
# contract, the API and the UI need no changes.
CHAIN_RPC_URL="http://127.0.0.1:8545"
CHAIN_ID=31337
CHAIN_NAME="Hardhat local"
# Blank on a local chain; "https://amoy.polygonscan.com" on Amoy, which makes
# the UI show explorer links.
CHAIN_EXPLORER_URL=""
ESCROW_CONTRACT_ADDRESS=""

# Signing keys. `pnpm chain` prints funded test accounts to use locally — those
# are published keys, fine for a local chain and never for a real one.
PLATFORM_PRIVATE_KEY=""
BUYER_PRIVATE_KEY=""
SETTLEMENT_ADDRESS=""

# ---------- Polygon Amoy (later) ----------
AMOY_RPC_URL="https://rpc-amoy.polygon.technology"
DEPLOYER_PRIVATE_KEY=""
POLYGONSCAN_API_KEY=""

# ---------- Chat assistant (Gemini) ----------
# Get a key at https://aistudio.google.com/apikey
# The free tier allows only 20 requests per day per model — the assistant
# falls back to a deterministic summary built from the user's own rows when
# that runs out, so the feature still works without a key at all.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"

# ---------- Razorpay (test mode) ----------
# Dashboard → Settings → API Keys, with the dashboard in TEST mode.
# Razorpay caps a single order at ₹5,00,000, so orders above that are funded
# with a labelled 10% advance — see services/api/src/lib/razorpay.ts.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
