{
  "name": "@fasalx/blockchain",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "compile": "hardhat compile && ts-node --project tsconfig.json scripts/export-abi.ts",
    "test": "hardhat test",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "deploy:amoy": "hardhat run scripts/deploy.ts --network amoy",
    "build": "hardhat compile --quiet && ts-node --project tsconfig.json scripts/export-abi.ts",
    "clean": "hardhat clean",
    "typecheck": "hardhat compile --quiet && tsc --noEmit"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-viem": "^2.0.6",
    "@openzeppelin/contracts": "^5.4.0",
    "@types/chai": "^4.3.20",
    "@types/chai-as-promised": "^7.1.8",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.18.1",
    "chai": "^4.5.0",
    "chai-as-promised": "^7.1.2",
    "dotenv": "^17.2.2",
    "hardhat": "^2.26.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "viem": "^2.37.5"
  },
  "exports": {
    "./abi": "./abi/FasalXEscrow.ts"
  }
}
