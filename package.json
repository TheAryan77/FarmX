{
  "name": "fasalx",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "ai:setup": "cd services/ai && python3 -m venv .venv && ./.venv/bin/pip install -q --upgrade pip && ./.venv/bin/pip install -r requirements.txt",
    "ai:dev": "cd services/ai && ./.venv/bin/uvicorn app.main:app --reload --port 8000"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "prisma": "^6.16.1",
    "turbo": "^2.5.8",
    "typescript": "^5.9.2"
  }
}
